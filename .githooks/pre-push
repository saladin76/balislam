#!/bin/sh
# بوابة التسليم (الأمر 010): لا يُدفع commit تفشل عليه الفحوص الإلزامية (الأنواع والاختبارات، وتزامن التوثيق — الأمر 016).
# يُفحص الـ commit المدفوع نفسه في نسخة منفصلة، لا ملفات العمل غير المحفوظة.
# التثبيت تلقائي مع npm install (scripts/install-hooks.mjs). الأمر git push --no-verify يتجاوزه
# محليًا ولا يُستعمل إلا بقرار صاحب المشروع.
z40=0000000000000000000000000000000000000000
# شجرة الـcommit غير فارغة وكل ملف فيها صندوق ملاحظات للمالك (صندوق حلقة، أو الصندوق العام للقناة D112)، ولا شيء غيره
notes_only() {
  files=$(git ls-tree -r --name-only "$1" 2>/dev/null) || return 1
  [ -n "$files" ] || return 1
  printf '%s\n' "$files" | grep -qvE '^channels/[a-z0-9-]+/(episodes/[^/]+/)?notes/inbox\.json$' && return 1
  return 0
}
# فرع معاينة سحابية (D75، src/render/cloudPreviews.ts): commit يتيم (بلا أب، فلا كود مخفي في تاريخه)،
# وشجرته ملفات عادية في الجذر: manifest.json وأجزاء part-NNN فقط، ولا شيء غيرها
preview_only() {
  git cat-file -e "$1^{commit}" 2>/dev/null || return 1
  git cat-file commit "$1" | sed '/^$/q' | grep -q '^parent ' && return 1
  entries=$(git ls-tree -r "$1" 2>/dev/null) || return 1
  [ -n "$entries" ] || return 1
  printf '%s\n' "$entries" | grep -qvE '^100644 blob [0-9a-f]+	(manifest\.json|part-[0-9]{3})$' && return 1
  printf '%s\n' "$entries" | grep -qE '	manifest\.json$' || return 1
  return 0
}
tested=""
while read local_ref local_sha remote_ref remote_sha; do
  # حذف فرع: لا شيء يُفحص
  [ "$local_sha" = "$z40" ] && continue
  case " $tested " in *" $local_sha "*) continue ;; esac
  # صندوق ملاحظات المالك (docs/studio/notes-inbox.md): الفرع studio-notes وحده، وبشرط أن شجرة الـcommit
  # المدفوع صناديق ملاحظات فقط. أي مرجع آخر (main وغيره)، أو شجرة فيها ملف آخر، تمر على البوابة كاملة.
  if [ "$remote_ref" = "refs/heads/studio-notes" ] && notes_only "$local_sha"; then
    echo "بوابة التسليم: $remote_ref صناديق ملاحظات فقط (channels/*/[episodes/*/]notes/inbox.json)؛ لا كود يُختبر."
    continue
  fi
  # معاينات الجلسات السحابية: refs/heads/previews/* وحدها، وبشرط preview_only. غير ذلك يمر على البوابة كاملة.
  case "$remote_ref" in
    refs/heads/previews/*)
      if preview_only "$local_sha"; then
        echo "بوابة التسليم: $remote_ref معاينة فقط (manifest.json وأجزاء الفيديو في commit يتيم)؛ لا كود يُختبر."
        continue
      fi ;;
  esac
  echo "بوابة التسليم: فحص $local_ref ($local_sha) قبل الدفع إلى $remote_ref…"
  # مدى الدفع لفحص تزامن التوثيق: من آخر ما في الفرع البعيد (إن كان معروفًا محليًا) إلى المدفوع
  range=""
  if [ "$remote_sha" != "$z40" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then range="--range $remote_sha..$local_sha"; fi
  node "$(git rev-parse --show-toplevel)/scripts/gate.mjs" --commit "$local_sha" $range || {
    echo "✗ رُفض الدفع إلى $remote_ref: الفحوص الإلزامية فشلت على $local_sha." >&2
    exit 1
  }
  tested="$tested $local_sha"
done
exit 0
