node_modules/
# رابط node_modules (ليس مجلدًا) لا يُحفظ أيضًا
node_modules
.env
# جلسات المالك على جهازه (D49): بصمات رموز الجلسة فقط، محلية ولا تُرفع أبدًا؛ وسجل الأخطاء .studio/errors.jsonl (D112)
.studio/
out/
renders/
*.log

# الملفات الكبيرة: تُحفظ على تخزين سحابي لا في Git
channels/*/episodes/*/voice/
channels/*/episodes/*/out/
channels/*/episodes/*/status.json
# نسخة الخطة المحلية عند تعارض التحديث
channels/*/episodes/*/plan.local.json
# النسخة الاحتياطية قبل الكتابة الصريحة فوق خطة مصمَّمة (bal plan --force-overwrite-designed): على الجهاز فقط
channels/*/episodes/*/plan.backup-*.json
# قفل كتابة الخطة (D110): حفظ الصفحة والشورتس وختم السلسلة تحته؛ محلي ولا يُرفع
channels/*/episodes/*/plan.json.write.lock
assets/recitations/**/*.wav
assets/recitations/**/*.mp3
assets/sfx/**/*.wav

# وسائط الرندر المؤقتة
# مكتبة العناصر المصدَّرة لكل قناة (bal elements) تُولَّد من الكود في renders/elements
assets/elements/
public/_render/
# مخزن صور Storyboard المؤقت؛ لا يُرفع إلى Git
public/_storyboard_media/
# لوحات الستوري بورد المرندرة من الخطة (bal storyboard <الحلقة> --stills): تُعاد بأمر واحد، لا تُرفع (الأمر 027)
channels/*/episodes/*/storyboard-stills/
# محتوى Quran Foundation لا يُحتفظ به أكثر من أسبوع (شروطهم): يُجلب على جهازك ولا يُرفع
channels/*/episodes/*/quran.json
channels/*/episodes/*/recitations/

# صور اللوحات الوثائقية (كبيرة الحجم)
channels/*/episodes/*/images/
channels/*/images/

# سكربتات مؤقتة للمعاينة والقياس (لا تُرفع)
*-tmp.mts

# المعاينات الصوتية فيها تلاوة Quran Foundation: تبقى على جهاز صاحب القناة ولا تُرفع
channels/*/episodes/*/previews/*-audio.mp4
channels/*/episodes/*/out/*-audio-preview.mp4

# Studio V2 per-episode signed owner decisions and transient ledger locks (local-only)
channels/*/episodes/*/scene-workflow.v2.json
channels/*/episodes/*/scene-workflow.v2.json.lock
channels/*/episodes/*/scene-workflow.v2.json.*.tmp

# فيديوهات المعاينات على Google Drive لا في Git (قرار صاحب المشروع، ٨ نوفمبر ٢٠٢٦):
# يُحفظ previews/index.json وحده (العنوان والبصمة ورابط Drive). الملفات المتتبَّعة قبل هذا القرار
# تبقى حتى تنظيف السجل بموافقة صاحب المشروع. وD109 (١٢ نوفمبر): أُزيل من التتبّع ما لا يستعمله شيء، والباقي
# مقفل بقائمة في tests/no-tracked-preview-videos.test.ts، فلا يدخل Git فيديو معاينة جديد ولو بـ git add -f.
channels/*/episodes/*/previews/*.mp4
channels/*/episodes/*/previews/history/
channels/*/episodes/*/previews/*.mov
channels/*/episodes/*/previews/*.webm
channels/*/episodes/*/previews/*.mkv
channels/*/episodes/*/previews/*.m4v
channels/*/episodes/*/previews/*.MP4
# وصل السرد في التجميع (src/studio/seamsRecord.ts): يخص ملف الفيديو المحلي وحده
channels/*/episodes/*/previews/*.seams.json

# صندوق ملاحظات المالك (docs/studio/notes-inbox.md): يكتبه الاستوديو محليًا ويُرفع وحده إلى الفرع studio-notes،
# فلا يُتتبع على main (وإلا عطّل git pull والتحديث). ردود Claude في notes/resolved.json وهي متتبَّعة على main.
channels/*/episodes/*/notes/inbox.json
channels/*/episodes/*/notes/*.json.*.tmp
# الصندوق العام للقناة: «أرسل المشكلة» لخطأ بلا حلقة (D112)، بالقاعدة نفسها
channels/*/notes/inbox.json
channels/*/notes/*.json.*.tmp

# حالة الاستوديو المحلية لكل حلقة (لا تُرفع، ولا تمنع زر «حدّث الآن»؛ app/server/update.ts).
# كلها موقَّعة بمفتاح الجهاز أو مربوطة بملفات محلية لا توجد في Git، فلا معنى لها على نسخة أخرى:
# - سجل اعتماد المشاهد الموقَّع (src/studio/sceneService.ts: stateFileFor، والقفل serialized، والكتابة الذرية)
channels/*/episodes/*/scene-production.v1.json
channels/*/episodes/*/scene-production.v1.json.lock
# - نسخة السكريبت كما اعتُمد (D66، أُلغيت بـ D76؛ قديمة، يؤرشفها `bal migrate legacy`، D120)
channels/*/episodes/*/script-approved.v1.json
channels/*/episodes/*/script-approved.v1.json.*.tmp
# - سجلات قديمة لا يقرؤها شيء (D120): ينقلها `bal migrate legacy` إلى .studio/legacy-archive/ عند تشغيل الاستوديو؛
#   تبقى متجاهَلة إن عادت من نسخة قديمة (سجل المراحل الست، واعتماد الصوت المنفصل، ونسخة السكريبت المعتمدة القديمة)
channels/*/episodes/*/workflow-approvals.json
channels/*/episodes/*/workflow-approvals.json.lock
channels/*/episodes/*/voice-review.json
# - قفل فهرس المعاينات (مجلد مؤقت؛ src/render/episodePreviews.ts: withPreviewIndexLock)
channels/*/episodes/*/previews/.preview-index.lock/
# - سجل مراجعة اللوحات (src/plan/storyboard.ts: storyboardFileFor). يكتبه «اعتمد التجهيز» على هذا الجهاز،
#   وسلطته كلها في السجل الموقَّع أعلاه: بصمة الستوري بورد فيه هي «جيل» هذا الملف (inode وctime)، فنسخة
#   من Git أو من جهاز آخر لا تعتمد شيئًا، وسحبها فوقه كان سيعيد فتح المشاهد. لم يُتتبع ملف منه قط (D60).
#   محمي في البداية النظيفة (fresh-start.command: is_protected) ولا يُحذف.
channels/*/episodes/*/storyboard.json
# - ملفات الكتابة الذرية المؤقتة لكل كاتب في مجلد الحلقة (*.<uuid>.tmp)
channels/*/episodes/*/*.tmp
channels/*/episodes/*/**/*.tmp
# ليست هنا عمدًا (متتبَّعة أو موثَّقة «في Git»): review.json وpublish.json وnotes/resolved.json
# (وscript-signoff.json وscene-review.json القديمان: يؤرشفهما `bal migrate legacy`، D120). لا تمنع «حدّث الآن» منذ D95: تُحفظ نسخة احتياطية منها وتبقى.

# الوصلات التي سمعها المالك في النسخة المجمعة (M6): حالة محلية مربوطة ببصمة التجميع، لا تُرفع
channels/*/episodes/*/seam-checks.local.json
channels/*/episodes/*/seam-checks.local.json.lock
