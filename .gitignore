node_modules/
# رابط node_modules (ليس مجلدًا) لا يُحفظ أيضًا
node_modules
.env
out/
renders/
*.log

# الملفات الكبيرة: تُحفظ على تخزين سحابي لا في Git
channels/*/episodes/*/voice/
channels/*/episodes/*/out/
channels/*/episodes/*/status.json
# نسخة الخطة المحلية عند تعارض التحديث
channels/*/episodes/*/plan.local.json
assets/recitations/**/*.wav
assets/recitations/**/*.mp3
assets/sfx/**/*.wav

# وسائط الرندر المؤقتة
# مكتبة العناصر المصدَّرة لكل قناة (bal elements) تُولَّد من الكود في renders/elements
assets/elements/
public/_render/
# مخزن صور Storyboard المؤقت؛ لا يُرفع إلى Git
public/_storyboard_media/
# لوحات الستوري بورد المرندرة من الخطة (bal storyboard <الحلقة> --stills): تُعاد بأمر واحد، لا تُرفع (الأمر 027)
channels/*/episodes/*/storyboard-stills/
# محتوى Quran Foundation لا يُحتفظ به أكثر من أسبوع (شروطهم): يُجلب على جهازك ولا يُرفع
channels/*/episodes/*/quran.json
channels/*/episodes/*/recitations/

# صور اللوحات الوثائقية (كبيرة الحجم)
channels/*/episodes/*/images/
channels/*/images/

# سكربتات مؤقتة للمعاينة والقياس (لا تُرفع)
*-tmp.mts

# المعاينات الصوتية فيها تلاوة Quran Foundation: تبقى على جهاز صاحب القناة ولا تُرفع
channels/*/episodes/*/previews/*-audio.mp4
channels/*/episodes/*/out/*-audio-preview.mp4

# Studio V2 per-episode signed owner decisions and transient ledger locks (local-only)
channels/*/episodes/*/scene-workflow.v2.json
channels/*/episodes/*/scene-workflow.v2.json.lock
channels/*/episodes/*/scene-workflow.v2.json.*.tmp

# فيديوهات المعاينات على Google Drive لا في Git (قرار صاحب المشروع، ٨ نوفمبر ٢٠٢٦):
# يُحفظ previews/index.json وحده (العنوان والبصمة ورابط Drive). الملفات المتتبَّعة قبل هذا القرار
# تبقى حتى تنظيف السجل بموافقة صاحب المشروع.
channels/*/episodes/*/previews/*.mp4
channels/*/episodes/*/previews/history/
