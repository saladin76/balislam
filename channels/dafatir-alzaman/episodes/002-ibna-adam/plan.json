            "reference": "مريم · ٥٦–٥٧",
            "reciter": ""
          },
          "sfx": [],
          "ayahKey": "19:56-57"
        },
        {
          "id": "c2-s27",
          "template": "horizon-shot",
          "narration": "وأثنى الله على إدريس عليه السلام، فوصفه بالصدق العظيم والنبوة، وأخبر برفعه مكانًا عليًّا.",
          "line": 195,
          "props": {
            "shot": "bd03-three-words"
          },
          "sfx": []
        },
        {
          "id": "c2-s28",
          "template": "horizon-shot",
          "narration": "وذكره الله مع الصابرين.",
          "line": 197,
          "props": {
            "shot": "bd03-three-words"
          },
          "sfx": []
        },
        {
          "id": "c2-s29",
          "template": "horizon-shot",
          "narration": "كما جاء في سورة الأنبياء:",
          "line": 199,
          "props": {
            "shot": "verse-tag",
            "ref": "الأنبياء · ٨٥",
            "tagWord": "الأنبياء"
          },
          "sfx": []
        },
        {
          "id": "c2-s30",
          "template": "verse-card",
          "narration": "",
          "line": 201,
          "props": {
            "text": "",
            "reference": "الأنبياء · ٨٥",
            "reciter": ""
          },
          "sfx": [],
          "ayahKey": "21:85"
        },
        {
          "id": "c2-s31",
          "template": "horizon-shot",
          "narration": "وفي حديث المعراج الصحيح أن النبي صلى الله عليه وسلم لقي إدريس عليه السلام في السماء الرابعة. وأما موضع إدريس على خطّ الأجيال، فلا نعلمه على التعيين.",
          "line": 205,
          "props": {
            "shot": "bd03-hadith-note"
          },
          "sfx": []
        },
        {
          "id": "c2-s32",
          "template": "hadith-card",
          "narration": "",
          "line": 207,
          "props": {
            "text": "ثُمَّ عُرِجَ بِنَا إِلَى السَّمَاءِ الرَّابِعَةِ… فَإِذَا أَنَا بِإِدْرِيسَ، فَرَحَّبَ وَدَعَا لِي بِخَيْرٍ",
            "narrator": "أنس بن مالك",
            "reference": "صحيح مسلم ١٦٢",
            "grade": "صحيح"
          },
          "sfx": []
        },
        {
          "id": "c2-s36",
          "template": "horizon-shot",
          "narration": "فماذا بقي في أيدينا؟ أصل واحد، وبداية على التوحيد، ونبيّ صادق رفع الله منزلته.",
          "line": 211,
          "props": {
            "shot": "bd03-what-remains"
          },
          "sfx": []
        },
        {
          "id": "c2-s37",
          "template": "horizon-shot",
          "narration": "وبين ذلك مسافة طويلة لا نعرف طولها، ولن نملأها بما لا نعرف.",
          "line": 215,
          "props": {
            "shot": "bd03-gap"
          },
          "sfx": []
        },
        {
          "id": "c2-s38",
          "template": "horizon-shot",
          "narration": "لكن الأمة الواحدة لم تبق واحدة. وفي الحلقة القادمة نسأل: ما الذي ثبت عن بداية الشرك؟",
