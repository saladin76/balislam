            "refWord": "آيات"
          },
          "sfx": []
        },
        {
          "id": "c1-s8",
          "template": "horizon-shot",
          "narration": "وأمر الله نبيه محمدًا صلى الله عليه وسلم أن يخبر الناس بخبرهما كما وقع.",
          "line": 46,
          "props": {
            "shot": "bd02-tell",
            "verseKey": "5:27",
            "verseText": "وَٱتْلُ عَلَيْهِمْ نَبَأَ ٱبْنَىْ ءَادَمَ بِٱلْحَقِّ إِذْ قَرَّبَا قُرْبَانًا فَتُقُبِّلَ مِنْ أَحَدِهِمَا وَلَمْ يُتَقَبَّلْ مِنَ ٱلْـَٔاخَرِ قَالَ لَأَقْتُلَنَّكَ ۖ قَالَ إِنَّمَا يَتَقَبَّلُ ٱللَّهُ مِنَ ٱلْمُتَّقِينَ",
