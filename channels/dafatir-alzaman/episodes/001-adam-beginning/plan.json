        },
        {
          "id": "c3-v4",
          "template": "verse-card",
          "narration": "",
          "line": 83,
          "ayahKey": "2:32",
          "durationSec": 4,
          "props": {
            "text": "",
            "reference": "البقرة · ٣٢",
            "reciter": "",
            "look": "horizon",
            "head": "الفصل الثالث"
          },
          "sfx": [],
          "edited": true
        },
        {
          "id": "c3-s8",
          "template": "horizon-shot",
          "narration": "ثم أمر الله آدم أن ينبئهم بأسمائها.",
          "line": 85,
          "props": {
            "shot": "verse-intro",
            "head": "الفصل الثالث",
            "ref": "البقرة · ٣٣"
          },
          "sfx": [],
          "edited": true
        },
        {
          "id": "c3-v5",
          "template": "verse-card",
          "narration": "",
          "line": 87,
          "ayahKey": "2:33",
          "durationSec": 4,
          "props": {
            "text": "",
            "reference": "البقرة · ٣٣",
            "reciter": "",
