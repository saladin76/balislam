        },
        {
          "id": "c3-s4",
          "template": "horizon-shot",
          "narration": "وفي هذه الآيات خبر خلق آدم عليه السلام، وتسويته، ونفخ الروح فيه.",
          "line": 71,
          "props": {
            "shot": "steps",
            "head": "الفصل الثالث",
            "ref": "ص ٧١–٧٢"
          },
          "sfx": [],
          "edited": true
        },
        {
          "id": "c3-s5",
          "template": "horizon-shot",
          "narration": "ثم أخبرنا الله بأنه علم آدم الأسماء كلها.",
          "line": 73,
          "props": {
            "shot": "verse-intro",
            "head": "الفصل الثالث",
            "ref": "البقرة · ٣١"
          },
          "sfx": [],
