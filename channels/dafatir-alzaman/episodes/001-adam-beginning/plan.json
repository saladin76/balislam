            "light": "ink",
            "subtitle": ""
          },
          "id": "c1-s1",
          "sfx": []
        },
        {
          "template": "timeline",
          "narration": "عرفت الأرض أمما كثيرة، وتعاقبت فيها أجيال لا يعلم عددها إلا الله.",
          "line": 15,
          "props": {
            "title": "عرفت الأرض",
            "events": "أممًا كثيرة\nأجيالًا لا يعلم عددها إلا الله",
            "element": ""
          },
          "id": "c1-s2",
          "sfx": []
        },
        {
          "template": "symbolic",
          "narration": "ولكن رحلتنا هذه لا تبدأ من مدينة قديمة، ولا من مملكة نسي الناس اسمها.",
          "line": 17,
          "props": {
            "element": "ruins-columns",
            "secondElement": "",
            "relation": "",
            "caption": "لا من مدينة قديمة، ولا من مملكة نسي الناس اسمها",
            "effect": "float",
            "cue": "مدينة"
          },
          "id": "c1-s3",
          "sfx": []
        },
        {
          "template": "noor-text",
          "narration": "إننا نبدأ من أبي البشر، آدم عليه السلام.",
          "line": 19,
          "props": {
            "text": "آدم عليه السلام",
            "light": "on",
            "subtitle": "أبو البشر"
          },
          "id": "c1-s4",
          "sfx": []
        },
        {
          "template": "noor-text",
          "narration": "من أول إنسان خلقه الله سبحانه وتعالى، ومنه بدأ نسل البشر الذي انتشر في الأرض.",
          "line": 21,
          "props": {
            "text": "أول إنسان",
            "light": "on",
            "subtitle": "ومنه بدأ نسل البشر"
          },
          "id": "c1-s5",
          "sfx": []
        },
        {
          "template": "symbolic",
          "narration": "ولا نملك تاريخا ثابتا لخلق آدم عليه السلام.",
          "line": 23,
          "props": {
            "element": "hourglass-ornate",
            "secondElement": "",
            "relation": "",
            "caption": "لا نملك تاريخًا ثابتًا لخلقه",
            "effect": "float",
            "cue": "تاريخا"
          },
          "id": "c1-s6",
          "sfx": []
        },
        {
          "template": "timeline",
          "narration": "فلم يخبرنا القرآن الكريم بالسنة التي خلق فيها، ولا بالزمن الذي يفصله عن أقدم الحضارات التي وصلت إلينا آثارها.",
          "line": 25,
          "props": {
            "title": "لم يخبرنا القرآن الكريم",
            "events": "بالسنة التي خلق فيها\nولا بالزمن الذي يفصله عن أقدم الحضارات",
            "element": ""
          },
          "id": "c1-s7",
          "sfx": []
        },
        {
          "template": "noor-text",
          "narration": "ولكن الله أخبرنا بما هو أعظم من تحديد سنة أو مكان.",
          "line": 27,
          "props": {
            "text": "بما هو أعظم من تحديد سنة أو مكان",
            "light": "ink",
            "subtitle": ""
          },
          "id": "c1-s8",
          "sfx": []
        },
        {
          "template": "timeline",
          "narration": "أخبرنا عن خلق آدم، وتكريمه، وتعليمه، وعن أمر الملائكة بالسجود له، وعن عداوة إبليس.",
          "line": 29,
          "props": {
            "title": "أخبرنا عن",
            "events": "خلق آدم\nتكريمه\nتعليمه\nسجود الملائكة\nعداوة إبليس",
            "element": ""
          },
          "id": "c1-s9",
          "sfx": []
        },
        {
          "template": "symbolic",
          "narration": "ثم أخبرنا عما جرى لآدم وزوجه، وهبوطهما إلى الأرض.",
          "line": 31,
          "props": {
            "element": "earth-globe",
            "secondElement": "",
