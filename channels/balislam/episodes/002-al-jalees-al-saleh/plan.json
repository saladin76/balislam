        },
        {
          "template": "hadith-card",
          "narration": "",
          "line": 91,
          "props": {
            "text": "الرَّجُلُ عَلَى دِينِ خَلِيلِهِ، فَلْيَنْظُرْ أَحَدُكُمْ مَنْ يُخَالِلُ",
            "narrator": "أبو هريرة",
            "reference": "سنن أبي داود ٤٨٣٣",
            "grade": "حسن"
          },
          "id": "c1-s40",
          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "والخليل هو الصديق القريب الذي تفتح له قلبك.",
          "line": 93,
          "props": {
