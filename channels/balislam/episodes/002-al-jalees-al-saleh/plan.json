          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "فقد ضربها النبي صلى الله عليه وسلم مثلًا للجليس الصالح وجليس السوء، فقال:",
          "line": 73,
          "props": {
            "place": "home",
            "mood": "dawn",
            "moodTo": "",
