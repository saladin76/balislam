          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "كانوا فقط يؤخرونها، ويقولون: ما زال في الوقت متسع.",
          "line": 53,
          "props": {
            "place": "home",
            "mood": "dawn",
