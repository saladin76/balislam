          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "لا يحدث هذا في يوم واحد. يحدث قليلًا قليلًا، مثل الرائحة.",
          "line": 45,
          "props": {
            "place": "home",
            "mood": "dawn",
