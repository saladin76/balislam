          "id": "c1-s31",
          "sfx": []
        },
        {
          "template": "hadith-card",
          "narration": "",
          "line": 75,
          "props": {
            "text": "مَثَلُ الجَلِيسِ الصَّالِحِ وَالسَّوْءِ، كَحَامِلِ المِسْكِ وَنَافِخِ الكِيرِ، فَحَامِلُ المِسْكِ: إِمَّا أَنْ يُحْذِيَكَ، وَإِمَّا أَنْ تَبْتَاعَ مِنْهُ، وَإِمَّا أَنْ تَجِدَ مِنْهُ رِيحًا طَيِّبَةً، وَنَافِخُ الكِيرِ: إِمَّا أَنْ يُحْرِقَ ثِيَابَكَ، وَإِمَّا أَنْ تَجِدَ رِيحًا خَبِيثَةً",
            "narrator": "أبو موسى الأشعري",
            "reference": "صحيح البخاري ٥٥٣٤",
            "grade": "صحيح"
          },
          "id": "c1-s32",
          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "والكير هو منفاخ الحدّاد الذي يُشعل به النار.",
          "line": 77,
          "props": {
            "place": "home",
            "mood": "dawn",
            "moodTo": "",
            "camera": "drift",
            "poses": "stand",
            "look": "hero",
            "cast": "",
            "cues": ""
          },
          "id": "c1-s33",
          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "تأمّل حامل المسك: إما أن يهديك، وإما أن تشتري منه، وإما أن تخرج برائحته.",
          "line": 79,
          "props": {
            "place": "home",
            "mood": "dawn",
            "moodTo": "",
            "camera": "push",
            "poses": "think,stand,nod",
            "look": "hero",
            "cast": "",
            "cues": "think | تأمّل"
          },
          "id": "c1-s34",
          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "أقل ما تأخذه منه رائحة طيبة، ولو لم تقصدها.",
          "line": 81,
          "props": {
            "place": "home",
            "mood": "dawn",
            "moodTo": "",
            "camera": "track",
            "poses": "sit,sit-low",
            "look": "hero",
            "cast": "",
            "cues": ""
          },
          "id": "c1-s35",
          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "وتأمّل نافخ الكير: إما أن تصيبك شرارة من ناره، وإما أن تخرج برائحة الدخان.",
          "line": 83,
          "props": {
            "place": "home",
            "mood": "dawn",
            "moodTo": "",
            "camera": "rise",
            "poses": "think,stand",
            "look": "hero",
            "cast": "",
            "cues": "think | وتأمّل"
          },
          "id": "c1-s36",
          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "أقل ما تأخذه منه رائحة لا تحبها، ولو لم تقترب من النار.",
          "line": 85,
          "props": {
            "place": "home",
            "mood": "dawn",
            "moodTo": "",
            "camera": "drift",
            "poses": "stand,think",
            "look": "hero",
            "cast": "",
            "cues": ""
          },
          "id": "c1-s37",
          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "فالمجالسة لا تمر دون أثر. السؤال فقط: أي أثر؟",
