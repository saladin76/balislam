          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "فلماذا نتأثر بهذا القدر، ونحن نظن أننا مستقلون في آرائنا؟",
          "line": 59,
          "props": {
            "place": "home",
            "mood": "dawn",
            "moodTo": "",
            "camera": "drift",
            "poses": "stand,think",
            "look": "hero",
            "cast": "",
            "cues": ""
