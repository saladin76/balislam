          "id": "c1-s14",
          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "وصديقك الذي يقرأ، تجد نفسك تسأله عن كتابه، ثم تشتري مثله.",
          "line": 41,
          "props": {
