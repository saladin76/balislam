          "id": "c1-s24",
          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "لأن ما يتكرر أمام أعيننا يصبح مألوفًا، وما يصبح مألوفًا لا نعود نسأل عنه.",
          "line": 61,
          "props": {
