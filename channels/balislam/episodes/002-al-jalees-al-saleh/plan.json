            "cues": ""
          },
          "id": "c1-s19",
          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "لم يسخر منه أحد، ولم يطلب منه أحد أن يترك شيئًا.",
          "line": 51,
          "props": {
            "place": "home",
            "mood": "dawn",
            "moodTo": "",
            "camera": "drift",
            "poses": "stand,think",
            "look": "hero",
