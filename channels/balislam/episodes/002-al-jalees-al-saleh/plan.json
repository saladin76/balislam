          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "ثم صار له أصحاب طيبون في أشياء كثيرة، لكنهم لا يبالون بالصلاة.",
          "line": 49,
          "props": {
            "place": "home",
            "mood": "dawn",
