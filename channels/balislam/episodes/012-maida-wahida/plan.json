      "scenes": [
        {
          "template": "alley-tale",
          "narration": "هل يمكن لمائدة واحدة أن تكفي حارة كاملة؟",
          "line": 13,
          "props": {
            "place": "alley",
            "mood": "dawn",
            "moodTo": "",
