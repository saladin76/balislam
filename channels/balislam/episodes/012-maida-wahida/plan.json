          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "قل: الطعام أطيب حين يُقسم، كما قالت الجدة.",
          "line": 97,
          "props": {
            "place": "alley",
            "mood": "dawn",
            "moodTo": "",
