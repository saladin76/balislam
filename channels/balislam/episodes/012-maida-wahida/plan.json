            "reciter": ""
          },
          "id": "c1-s38",
          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "فكيف نجعل مائدتنا تتسع في هذا الشهر؟",
          "line": 89,
          "props": {
            "place": "alley",
            "mood": "dawn",
            "moodTo": "",
            "camera": "rise",
            "poses": "stand",
            "look": "hero",
            "cast": "",
            "cues": ""
          },
          "id": "c1-s39",
          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "ابدأ بالأقرب: من في حارتك يفطر وحده؟ كبير في السن، أو مغترب، أو بيت فقد عائله.",
          "line": 91,
          "props": {
            "place": "alley",
            "mood": "dawn",
            "moodTo": "",
            "camera": "drift",
            "poses": "stand,think,nod",
            "look": "hero",
            "cast": "",
            "cues": ""
          },
          "id": "c1-s40",
          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "ثم ابدأ بالقليل: طبق واحد يكفي، ولا تنتظر أن تُعدّ وليمة.",
          "line": 93,
          "props": {
            "place": "alley",
            "mood": "dawn",
            "moodTo": "",
            "camera": "push",
            "poses": "stand,think",
            "look": "hero",
            "cast": "",
            "cues": "companion | واحد"
          },
          "id": "c1-s41",
          "sfx": []
        },
        {
          "template": "alley-tale",
          "narration": "وأرسله بلطف، دون أن تُشعر أحدًا بأنه محتاج.",
          "line": 95,
          "props": {
            "place": "alley",
            "mood": "dawn",
            "moodTo": "",
            "camera": "track",
            "poses": "sit,sit-low",
            "look": "hero",
