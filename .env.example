# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى Git أبدًا.

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# اختياري: مسار متصفح Chromium موجود مسبقًا لرندر Remotion.
# إن تُرك فارغًا، يحمّل Remotion متصفحه تلقائيًا في أول رندر.
REMOTION_BROWSER_EXECUTABLE=

# مجلد Google Drive المتزامن على جهازك (Google Drive for desktop): كل معاينة تُنسخ إليه تلقائيًا،
# والاستوديو يشغّل منه المعاينات المرفوعة من جهاز آخر بعد التحقق من بصمتها. مثال:
# BAL_DRIVE_PREVIEWS_DIR=~/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/balislam-previews
BAL_DRIVE_PREVIEWS_DIR=

# النشر يدوي بالكامل (D53): بعد «إذن النشر» تُنسخ الملفات المعتمدة بأعلى جودة إلى
# <My Drive>/balislam-publish/<القناة>/<مجلد الحلقة>/ ، ويرفعها Google Drive for desktop.
# فارغ = يُكتشف مجلد My Drive تلقائيًا (~/Library/CloudStorage/GoogleDrive-…/My Drive). اكتب off لإيقافه. مثال:
# BAL_DRIVE_PUBLISH_DIR=~/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive
BAL_DRIVE_PUBLISH_DIR=
