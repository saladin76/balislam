#!/bin/bash
# تشغيل استوديو بالإسلام على الماك: دبل كليك على الملف ده.
cd "$(dirname "$0")" || exit 1
[ -d node_modules ] || npm install
echo "التحقق من التحديثات…"
npx tsx app/server/update-run.ts || echo "تعذّر التحقق من التحديثات (هنكمل بالنسخة الحالية)"
( sleep 3; open "http://127.0.0.1:4321" ) &
echo "الاستوديو شغال. سيب النافذة دي مفتوحة؛ للإيقاف: Ctrl + C"
echo "التحديثات الجديدة هتظهر في شريط أعلى الاستوديو، من غير ما تقفل حاجة."
npm run app
