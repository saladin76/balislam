{
  "name": "balislam",
  "version": "0.2.0",
  "private": true,
  "description": "استوديو إنتاج ثلاث قنوات (بالإسلام، دفاتر الزمن، زبدة الكتب): السكريبت يتحول إلى حلقة 16:9 وشورتس 9:16 وحزمة نشر",
  "type": "module",
  "bin": {
    "bal": "./bin/bal.mjs"
  },
  "scripts": {
    "bal": "node bin/bal.mjs",
    "studio": "remotion studio src/remotion/index.ts",
    "stills": "node bin/bal.mjs stills",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "app": "node scripts/studio.mjs",
    "check": "npm run typecheck && npm test",
    "gate": "node scripts/gate.mjs",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "e2e:ui": "tsx tests/e2e/ui/studio-journey.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "sfx:master": "node scripts/sfx-master.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saladin76/balislam.git"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "^4.0.539",
    "@remotion/cli": "^4.0.539",
    "@remotion/player": "4.0.539",
    "@remotion/renderer": "^4.0.539",
    "@remotion/three": "4.0.539",
    "commander": "^15.0.0",
    "d3-geo": "^3.1.1",
    "music-metadata": "^12.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.539",
    "three": "0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "yaml": "^2.9.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@types/topojson-client": "^3.1.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "UNLICENSED"
}
